// Cloudflare Workers (静的アセット配信) のデプロイ設定。
// ビルド済みの dist/ をそのまま配信するだけで、Workerスクリプトは持たない。
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "overlaycam-web",
  "compatibility_date": "2026-07-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
